# All variables below are required at startup (the app throws a clear error naming
# whichever one is missing) except VITE_ENABLE_CHAT and VITE_DOLU_API_URL.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# The FastAPI backend's base URL (local dev: your uvicorn/Lambda-emulator address;
# production: the deployed Function URL, no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000

# The DOLU chat service is deployed separately; leave the chat UI off unless it is.
VITE_ENABLE_CHAT=false
# Only read when VITE_ENABLE_CHAT=true.
VITE_DOLU_API_URL=http://127.0.0.1:8001
