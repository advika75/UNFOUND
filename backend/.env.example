# Required by the FastAPI catalog and discovery endpoints.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key

# Optional aliases/privileged maintenance credentials. Never expose service-role keys to Vite.
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required only by direct PostgreSQL maintenance/backfill commands.
DATABASE_URL=postgresql://user:password@host:5432/database

# Required only by OpenAI-assisted classification commands.
OPENAI_API_KEY=your-openai-api-key
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
OPENAI_CLASSIFICATION_MODEL=gpt-4.1-mini

# Comma-separated browser origins allowed by CORS (default is the Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173
# Set to "production" when deployed: disables debug fields in API responses (default "development" leaves them on).
ENVIRONMENT=development

# Optional runtime tuning.
CLIP_MODEL_NAME=clip-ViT-B-32
SEARCH_LIMIT=20
DISCOVER_CANDIDATE_LIMIT=80
CATEGORY_AUTO_THRESHOLD=0.80
PERSONALIZATION_WEIGHT=0.10
SUPABASE_PRODUCT_IMAGE_BUCKET=product-images
# Required to call administrative catalog endpoints. Generate locally; never expose to Vite.
ADMIN_API_KEY=
SUPABASE_BRAND_IMAGE_BUCKET=brand-images

# Optional hybrid-ranking overrides; defaults are defined in backend/app.py.
TEXT_WEIGHT_SEMANTIC=0.22
TEXT_WEIGHT_LEXICAL=0.08
TEXT_WEIGHT_CATEGORY=0.12
TEXT_WEIGHT_PRODUCT_FAMILY=0.22
TEXT_WEIGHT_PRODUCT_TYPE=0.20
TEXT_WEIGHT_COLOUR=0.06
TEXT_WEIGHT_STYLE=0.04
TEXT_WEIGHT_FIT=0.02
TEXT_WEIGHT_GENDER=0.02
TEXT_WEIGHT_NICHE=0.02
IMAGE_WEIGHT_VISUAL=0.72
IMAGE_WEIGHT_CATEGORY=0.09
IMAGE_WEIGHT_PRODUCT_TYPE=0.06
IMAGE_WEIGHT_COLOUR=0.03
IMAGE_WEIGHT_STYLE=0.03
IMAGE_WEIGHT_GENDER=0.02
IMAGE_WEIGHT_NICHE=0.05
