# Only relevant for the Hugging Face Space remote -- the ONNX artifacts stay
# .gitignore'd (and untracked) for the default/GitHub remote. See infra notes in
# README.md's "Deployment note" section and the HF Space setup instructions for the
# `git add -f` step this requires.
backend/ml/artifacts/**/*.onnx filter=lfs diff=lfs merge=lfs -text
backend/ml/artifacts/**/tokenizer.json filter=lfs diff=lfs merge=lfs -text
# export_metadata.json / preprocessor_config.json are under 1KB each -- not worth LFS.
